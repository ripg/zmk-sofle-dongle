#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include <behaviors/runtime-sensor-rotate.dtsi>

/ {
    zip_scroll_scaler: zip_scroll_scaler {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
        track-remainders;
    };
};

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&lt {
    tapping-term-ms = <100>;
    flavor = "hold-preferred";
};

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <0>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <400>;
    acceleration-exponent = <1>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    behaviors {
        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };
    };

    macros {
        shift_MB3: shift_MB3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_press>,
                <&mkp MB3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mkp MB3 &kp LEFT_SHIFT>;

            label = "SHIFT_MB3";
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            bindings = <
&kp ESC     &kp N1     &kp N2        &kp N3        &kp N4  &kp N5       &kp UP_ARROW     &kp N6     &kp N7     &kp N8     &kp N9           &kp N0      &kp BACKSPACE
&kp TAB     &kp Q      &kp W         &kp E         &kp R   &kp T        &kp DOWN_ARROW   &kp Y      &kp U      &kp I      &kp O            &kp P       &kp BSLH
&kp CAPS    &kp A      &kp S         &kp D         &kp F   &kp G        &kp LEFT_ARROW   &kp H      &kp J      &kp K      &kp L            &kp SEMI    &kp APOS
&kp LSHFT   &kp Z      &kp X         &kp C         &kp V   &kp B        &kp RIGHT_ARROW  &kp N      &kp M      &kp COMMA  &kp DOT          &kp FSLH    &kp ENTER
&kp C_MUTE  &kp LCTRL  &kp LEFT_GUI  &kp LEFT_ALT  &mo 1   &kp SPACE    &kp ENTER        &kp SPACE  &kp ENTER  &mo 2      &kp RIGHT_SHIFT  &kp DELETE
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;

            display-name = "L0";
        };

        layer_1 {
            bindings = <
&kp TILDE     &kp F1                &kp F2           &kp F3          &kp F4         &kp F5       &mmv MOVE_UP     &kp F8          &kp F9           &kp F10          &kp F11          &kp F12           &trans
&trans        &kp LC(LS(NUMBER_1))  &kp LA(LC(DEL))  &kp LS(ESCAPE)  &kp LS(GRAVE)  &kp F6       &mmv MOVE_DOWN   &kp F7          &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp MINUS         &kp EQUAL
&kp CAPSLOCK  &kp TILDE             &trans           &kp LG(D)       &kp LG(SPACE)  &kp LG(L)    &mmv MOVE_LEFT   &trans          &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&trans        &trans                &kp LA(F4)       &trans          &mkp LCLK      &mkp RCLK    &mmv MOVE_RIGHT  &kp KP_NUMLOCK  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &trans            &trans
&kp C_MUTE    &out OUT_TOG          &trans           &trans          &trans         &trans       &mkp LCLK        &trans          &trans           &trans           &kp KP_NUMBER_0  &trans
            >;

            display-name = "L1";
            sensor-bindings = <&rsr_vol &rsr_trans>;

        };

        layer_2 {
            bindings = <
&kp TILDE  &trans  &trans  &trans  &trans  &trans    &mmv MOVE_UP     &trans  &trans      &trans        &trans      &trans       &sys_reset
&trans     &trans  &trans  &trans  &trans  &trans    &mmv MOVE_DOWN   &trans  &kp HOME    &kp UP_ARROW  &kp END     &kp UNDER    &kp PLUS
&trans     &trans  &trans  &trans  &trans  &trans    &mmv MOVE_LEFT   &trans  &kp LEFT    &kp DOWN      &kp RIGHT   &kp LBRC     &kp RBRC
&trans     &trans  &trans  &trans  &trans  &trans    &mmv MOVE_RIGHT  &trans  &kp INSERT  &trans        &kp DELETE  &bootloader  &rgb_ug RGB_TOG
&trans     &trans  &trans  &trans  &trans  &trans    &mkp LCLK        &trans  &trans      &trans        &trans      &soft_off
            >;
             display-name = "L2";
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };
    };
};
